@page "/suppliers/{SupplierId:int}"
@attribute [Authorize(Policy = Permissions.SuppliersView)]
@inject ServiceRunner Services
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IAuthorizationService AuthorizationService

<PageTitle>@(_supplier?.Name ?? L["Nav.Suppliers"]) - @L["App.Name"]</PageTitle>

<div class="page-header">
    <MudIconButton Icon="@(SupportedCultures.IsArabicUi ? Icons.Material.Filled.ArrowForward : Icons.Material.Filled.ArrowBack)"
                   Href="suppliers" aria-label="@L["Products.BackToList"]" title="@L["Products.BackToList"]" />
    <MudText Typo="Typo.h4">@(_supplier?.Name ?? L["Nav.Suppliers"])</MudText>
    @if (_supplier is { IsActive: false })
    {
        <MudChip T="string" Size="Size.Small">@L["Users.Inactive"]</MudChip>
    }
</div>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning">@L["Errors.NotFound"]</MudAlert>
    return;
}

@if (_supplier is not { } supplier)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    return;
}

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <MudSimpleTable Dense="true" Elevation="0">
                <tbody>
                    <tr><td>@L["Suppliers.Phone"]</td><td dir="ltr">@supplier.Phone</td></tr>
                    <tr><td>@L["Suppliers.Address"]</td><td>@supplier.Address</td></tr>
                    <tr><td>@L["Suppliers.Notes"]</td><td>@supplier.Notes</td></tr>
                </tbody>
            </MudSimpleTable>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudText Typo="Typo.caption">@L["Payables.Owed"]</MudText>
            <MudText Typo="Typo.h4" Class="@(supplier.Balance > 0 ? "delta-negative" : string.Empty)">
                <span dir="ltr">@MoneyFormat.Format(supplier.Balance)</span>
            </MudText>
            <div class="d-flex flex-wrap gap-2 mt-3">
                @if (_canPay && supplier.Balance > 0)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Payments" OnClick="PayAsync">
                        @L["Payables.Pay"]
                    </MudButton>
                }
                @if (_canBuy && supplier.IsActive)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AddShoppingCart" Href="@($"purchases/new?supplier={supplier.Id}")">
                        @L["Purchases.New"]
                    </MudButton>
                }
                @if (_canSetOpening && !supplier.HasOpeningBalance)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AccountBalance" OnClick="OpeningBalanceAsync">
                        @L["Payables.SetOpeningBalance"]
                    </MudButton>
                }
                @if (_canManage)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditAsync">
                        @L["Common.Edit"]
                    </MudButton>
                }
            </div>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudText Typo="Typo.h6" GutterBottom="true">@L["Payables.Statement"]</MudText>
<MudTable @ref="_table" T="SupplierEntryRow" ServerData="LoadStatementAsync" Dense="true" Hover="true" Elevation="1" RowsPerPage="25">
    <HeaderContent>
        <MudTh>@L["Audit.Time"]</MudTh>
        <MudTh>@L["Inventory.MovementType"]</MudTh>
        <MudTh>@L["Payables.Reference"]</MudTh>
        <MudTh>@L["Cash.Amount"]</MudTh>
        <MudTh>@L["Cash.BalanceAfter"]</MudTh>
        <MudTh>@L["Cash.Note"]</MudTh>
        <MudTh>@L["Login.UserName"]</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@L["Audit.Time"]">@LocalizerExtensions.LocalTime(context.OccurredAtUtc)</MudTd>
        <MudTd DataLabel="@L["Inventory.MovementType"]">
            @L[$"SupplierEntryTypes.{context.Type}"]
            @if (context.PaymentReversed)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["Payables.Reversed"]</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="@L["Payables.Reference"]">
            @if (context.ReferenceType == PurchaseService.InvoiceReference && context.ReferenceId is { } invoiceId && _canViewPurchases)
            {
                <MudLink Href="@($"purchases/{invoiceId}")"><span dir="ltr">@context.ReferenceNumber</span></MudLink>
            }
            else
            {
                <span dir="ltr">@context.ReferenceNumber</span>
            }
        </MudTd>
        <MudTd DataLabel="@L["Cash.Amount"]"><span dir="ltr" class="@(context.Amount > 0 ? "delta-negative" : "delta-positive")">@MoneyFormat.FormatSigned(context.Amount)</span></MudTd>
        <MudTd DataLabel="@L["Cash.BalanceAfter"]"><span dir="ltr">@MoneyFormat.Format(context.BalanceAfter)</span></MudTd>
        <MudTd DataLabel="@L["Cash.Note"]">@context.Note</MudTd>
        <MudTd DataLabel="@L["Login.UserName"]"><span dir="ltr">@context.UserName</span></MudTd>
        <MudTd>
            @if (_canReverse && context is { Type: SupplierEntryType.Payment, PaymentReversed: false, ReferenceId: not null })
            {
                <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => ReverseAsync(context)">@L["Payables.Reverse"]</MudButton>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>@L["Payables.NoEntries"]</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="[25, 50, 100]" RowsPerPageString="@L["Pager.RowsPerPage"]" InfoFormat="@L["Pager.InfoFormat"]" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<SupplierEntryRow>? _table;
    private SupplierDetail? _supplier;
    private bool _notFound;
    private bool _canManage;
    private bool _canPay;
    private bool _canReverse;
    private bool _canSetOpening;
    private bool _canBuy;
    private bool _canViewPurchases;

    [Parameter]
    public int SupplierId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState).User;
        _canManage = (await AuthorizationService.AuthorizeAsync(user, Permissions.SuppliersManage)).Succeeded;
        _canPay = (await AuthorizationService.AuthorizeAsync(user, Permissions.PayablesPay)).Succeeded;
        _canReverse = (await AuthorizationService.AuthorizeAsync(user, Permissions.PayablesReverse)).Succeeded;
        _canSetOpening = (await AuthorizationService.AuthorizeAsync(user, Permissions.PayablesSetOpeningBalance)).Succeeded;
        _canBuy = (await AuthorizationService.AuthorizeAsync(user, Permissions.PurchasingCreate)).Succeeded;
        _canViewPurchases = (await AuthorizationService.AuthorizeAsync(user, Permissions.PurchasingView)).Succeeded;
    }

    protected override Task OnParametersSetAsync() => LoadSupplierAsync();

    private async Task LoadSupplierAsync()
    {
        var result = await Services.For<SupplierQueryService>().RunAsync(s => s.GetAsync(SupplierId));
        _notFound = result.IsFailure;
        _supplier = result.IsSuccess ? result.Value : null;
    }

    private Task<TableData<SupplierEntryRow>> LoadStatementAsync(TableState state, CancellationToken cancellationToken) =>
        TableDataLoader.LoadAsync(() => LoadStatementPageAsync(state, cancellationToken), cancellationToken);

    private async Task<TableData<SupplierEntryRow>> LoadStatementPageAsync(TableState state, CancellationToken cancellationToken)
    {
        var result = await Services.For<SupplierQueryService>().RunAsync(s => s.GetStatementAsync(
            new StatementQuery(SupplierId, state.Page, state.PageSize), cancellationToken));
        return result.IsSuccess
            ? new TableData<SupplierEntryRow> { Items = result.Value.Items, TotalItems = result.Value.TotalCount }
            : new TableData<SupplierEntryRow> { Items = [], TotalItems = 0 };
    }

    private Task EditAsync() =>
        ShowAsync<SupplierDialog>(L["Common.Edit"], new DialogParameters<SupplierDialog> { { d => d.Existing, _supplier } }, "Common.Saved");

    private Task PayAsync() =>
        ShowAsync<PaySupplierDialog>(L["Payables.Pay"], new DialogParameters<PaySupplierDialog> { { d => d.Supplier, _supplier! } }, "Payables.PaymentSaved");

    private Task OpeningBalanceAsync() =>
        ShowAsync<SupplierOpeningBalanceDialog>(
            L["Payables.SetOpeningBalance"], new DialogParameters<SupplierOpeningBalanceDialog> { { d => d.SupplierId, SupplierId } }, "Common.Saved");

    private Task ReverseAsync(SupplierEntryRow row) =>
        ShowAsync<ReversePaymentDialog>(
            L["Payables.Reverse"],
            new DialogParameters<ReversePaymentDialog> { { d => d.PaymentId, (int)row.ReferenceId!.Value }, { d => d.Amount, -row.Amount } },
            "Payables.PaymentReversedMessage");

    private async Task ShowAsync<TDialog>(string title, DialogParameters<TDialog> parameters, string savedMessageKey)
        where TDialog : Microsoft.AspNetCore.Components.IComponent
    {
        var dialog = await DialogService.ShowAsync<TDialog>(title, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(L[savedMessageKey], Severity.Success);
            await LoadSupplierAsync();
            if (_table is not null)
            {
                await _table.ReloadServerData();
            }
        }
    }
}
