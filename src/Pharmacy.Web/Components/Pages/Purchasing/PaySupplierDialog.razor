@inject ServiceRunner Services

<MudDialog>
    <DialogContent>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }

        <MudText Typo="Typo.body2" Class="mb-2">
            @L["Payables.Owed"]: <b dir="ltr">@MoneyFormat.Format(Supplier.Balance)</b>
        </MudText>

        <div class="d-flex align-end gap-2">
            <MudNumericField T="decimal?" @bind-Value="_amount" Label="@L["Cash.Amount"]" Min="0" Max="Supplier.Balance" Format="0.00" Immediate="true" Class="flex-grow-1" />
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mb-2" OnClick="() => _amount = Supplier.Balance">@L["Payables.PayAll"]</MudButton>
        </div>

        <MudTextField @bind-Value="_note" Label="@L["Payables.NoteOptional"]" MaxLength="SupplierAccountEntry.NoteMaxLength" Lines="2" Class="mt-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">@L["Common.Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_saving || _amount is null)" OnClick="SaveAsync">
            @L["Payables.Pay"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public SupplierDetail Supplier { get; set; } = default!;

    // One id per opened dialog: a double click or a retry is applied only once.
    private readonly Guid _operationId = Guid.NewGuid();
    private decimal? _amount;
    private string? _note;
    private string? _error;
    private bool _saving;

    private async Task SaveAsync()
    {
        _error = null;
        _saving = true;
        try
        {
            var request = new PaySupplierRequest(_operationId, Supplier.Id, _amount ?? 0m, _note);
            var result = await Services.For<PayablesService>().RunAsync(s => s.PayAsync(request));

            if (result.IsFailure)
            {
                _error = L.Message(result.Error!);
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _saving = false;
        }
    }
}
