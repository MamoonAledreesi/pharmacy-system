@page "/purchases/{InvoiceId:int}"
@attribute [Authorize(Policy = Permissions.PurchasingView)]
@inject ServiceRunner Services

<PageTitle>@L["Purchases.Invoice"] - @L["App.Name"]</PageTitle>

<div class="page-header">
    <MudIconButton Icon="@(SupportedCultures.IsArabicUi ? Icons.Material.Filled.ArrowForward : Icons.Material.Filled.ArrowBack)"
                   Href="purchases" aria-label="@L["Products.BackToList"]" title="@L["Products.BackToList"]" />
    <MudText Typo="Typo.h4">@L["Purchases.Invoice"] <span dir="ltr">@_invoice?.Number</span></MudText>
    <MudSpacer />
    @if (_invoice is not null)
    {
        <AuthorizeView Policy="@Permissions.PurchasingReturn">
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.AssignmentReturn" Href="@($"purchases/{_invoice.Id}/return")">
                @L["Purchases.ReturnGoods"]
            </MudButton>
        </AuthorizeView>
    }
</div>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning">@L["Errors.NotFound"]</MudAlert>
    return;
}

@if (_invoice is not { } invoice)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    return;
}

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <MudSimpleTable Dense="true" Elevation="0">
                <tbody>
                    <tr><td>@L["Purchases.InvoiceDate"]</td><td>@invoice.InvoiceDate.ToString("d", CultureInfo.CurrentCulture)</td></tr>
                    <tr>
                        <td>@L["Purchases.Supplier"]</td>
                        <td>
                            @if (invoice.SupplierId is { } supplierId)
                            {
                                <MudLink Href="@($"suppliers/{supplierId}")">@invoice.SupplierName</MudLink>
                            }
                            else
                            {
                                @(invoice.SupplierName ?? L["Purchases.UnregisteredSeller"])
                            }
                        </td>
                    </tr>
                    <tr><td>@L["Purchases.SupplierInvoiceNumber"]</td><td dir="ltr">@invoice.SupplierInvoiceNumber</td></tr>
                    <tr><td>@L["Cash.Note"]</td><td>@invoice.Note</td></tr>
                    <tr><td>@L["Purchases.EnteredBy"]</td><td><span dir="ltr">@invoice.UserName</span> · @LocalizerExtensions.LocalTime(invoice.CreatedAtUtc)</td></tr>
                </tbody>
            </MudSimpleTable>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSimpleTable Dense="true" Elevation="0">
                <tbody>
                    <tr><td>@L["Purchases.Total"]</td><td dir="ltr"><b>@MoneyFormat.Format(invoice.Total)</b></td></tr>
                    <tr><td>@L["Purchases.PaidCash"]</td><td dir="ltr">@MoneyFormat.Format(invoice.PaidCash)</td></tr>
                    <tr><td>@L["Purchases.OnCredit"]</td><td dir="ltr">@MoneyFormat.Format(invoice.OnCredit)</td></tr>
                </tbody>
            </MudSimpleTable>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="invoice.Lines" T="PurchaseLineDetail" Dense="true" Hover="true" Elevation="1">
    <HeaderContent>
        <MudTh>@L["Inventory.Product"]</MudTh>
        <MudTh>@L["Products.Unit"]</MudTh>
        <MudTh>@L["Inventory.Quantity"]</MudTh>
        <MudTh>@L["Purchases.BaseQuantity"]</MudTh>
        <MudTh>@L["Purchases.UnitCost"]</MudTh>
        <MudTh>@L["Inventory.BatchNumber"]</MudTh>
        <MudTh>@L["Inventory.ExpiryDate"]</MudTh>
        <MudTh>@L["Purchases.LineTotal"]</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@L["Inventory.Product"]">@context.Product.For(SupportedCultures.IsArabicUi) @context.Strength</MudTd>
        <MudTd DataLabel="@L["Products.Unit"]">@context.Unit.For(SupportedCultures.IsArabicUi)</MudTd>
        <MudTd DataLabel="@L["Inventory.Quantity"]">@context.Quantity</MudTd>
        <MudTd DataLabel="@L["Purchases.BaseQuantity"]"><b dir="ltr">@context.BaseQuantity</b></MudTd>
        <MudTd DataLabel="@L["Purchases.UnitCost"]"><span dir="ltr">@context.CostPerUnit.ToString("0.00##", CultureInfo.CurrentCulture)</span></MudTd>
        <MudTd DataLabel="@L["Inventory.BatchNumber"]"><span dir="ltr">@context.BatchNumber</span></MudTd>
        <MudTd DataLabel="@L["Inventory.ExpiryDate"]">@(context.ExpiryDate?.ToString("d", CultureInfo.CurrentCulture))</MudTd>
        <MudTd DataLabel="@L["Purchases.LineTotal"]"><span dir="ltr">@MoneyFormat.Format(context.LineTotal)</span></MudTd>
    </RowTemplate>
</MudTable>


@if (_returns.Count > 0)
{
    <MudText Typo="Typo.h6" Class="mt-5" GutterBottom="true">@L["Purchases.InvoiceReturns"]</MudText>
    <MudTable Items="_returns" T="PurchaseReturnListItem" Dense="true" Hover="true" Elevation="1">
        <HeaderContent>
            <MudTh>@L["Purchases.Number"]</MudTh>
            <MudTh>@L["Audit.Time"]</MudTh>
            <MudTh>@L["Purchases.Total"]</MudTh>
            <MudTh>@L["Purchases.DebtReduction"]</MudTh>
            <MudTh>@L["Purchases.CashReceived"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["Purchases.Number"]"><MudLink Href="@($"purchases/returns/{context.Id}")"><span dir="ltr">@context.Number</span></MudLink></MudTd>
            <MudTd DataLabel="@L["Audit.Time"]">@LocalizerExtensions.LocalTime(context.CreatedAtUtc)</MudTd>
            <MudTd DataLabel="@L["Purchases.Total"]"><span dir="ltr">@MoneyFormat.Format(context.Total)</span></MudTd>
            <MudTd DataLabel="@L["Purchases.DebtReduction"]"><span dir="ltr">@MoneyFormat.Format(context.DebtReduction)</span></MudTd>
            <MudTd DataLabel="@L["Purchases.CashReceived"]"><span dir="ltr">@MoneyFormat.Format(context.CashRefund)</span></MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private PurchaseDetail? _invoice;
    private IReadOnlyList<PurchaseReturnListItem> _returns = [];
    private bool _notFound;

    [Parameter]
    public int InvoiceId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var result = await Services.For<PurchaseQueryService>().RunAsync(s => s.GetAsync(InvoiceId));
        _notFound = result.IsFailure;
        _invoice = result.IsSuccess ? result.Value : null;
        var returns = await Services.For<PurchaseReturnQueryService>().RunAsync(s => s.SearchAsync(new PurchaseReturnQuery(null, InvoiceId, null, null, 0, PurchaseReturnQueryService.MaxPageSize)));
        _returns = returns.IsSuccess ? returns.Value.Items : [];
    }
}
