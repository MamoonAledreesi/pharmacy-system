@page "/not-found"
@layout MainLayout

<PageTitle>@L["NotFound.Title"] - @L["App.Name"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@L["NotFound.Title"]</MudText>
<MudText Typo="Typo.body1" Class="mb-4">@L["NotFound.Message"]</MudText>
<MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">@L["NotFound.BackHome"]</MudButton>
