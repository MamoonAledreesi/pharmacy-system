@page "/purchases/new"
@attribute [Authorize(Policy = Permissions.PurchasingCreate)]
@inject ServiceRunner Services
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject TimeProvider Clock

<PageTitle>@L["Purchases.New"] - @L["App.Name"]</PageTitle>

<div class="page-header">
    <MudIconButton Icon="@(SupportedCultures.IsArabicUi ? Icons.Material.Filled.ArrowForward : Icons.Material.Filled.ArrowBack)"
                   Href="purchases" aria-label="@L["Products.BackToList"]" title="@L["Products.BackToList"]" />
    <MudText Typo="Typo.h4">@L["Purchases.New"]</MudText>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
}

<MudPaper Class="pa-4 mb-4 form-page" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12">
            <MudDatePicker Date="_date" DateChanged="date => _date = date" Label="@L["Purchases.InvoiceDate"]" MaxDate="Clock.GetLocalNow().DateTime.Date" />
        </MudItem>
        <MudItem xs="12">
            <MudAutocomplete T="SupplierListItem" Label="@L["Purchases.Supplier"]" Value="_supplier" ValueChanged="OnSupplierChanged"
                             SearchFunc="SearchSuppliersAsync" ToStringFunc="SupplierText" MinCharacters="0" DebounceInterval="250"
                             CoerceText="false" Clearable="true" ShowProgressIndicator="true" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField @bind-Value="_supplierInvoiceNumber" Label="@L["Purchases.SupplierInvoiceNumber"]"
                          MaxLength="PurchaseInvoice.SupplierInvoiceNumberMaxLength" Style="direction: ltr" />
        </MudItem>
        @if (_supplier is null)
        {
            <MudItem xs="12">
                <MudTextField @bind-Value="_sellerName" Label="@L["Purchases.SellerName"]" HelperText="@L["Purchases.SellerNameHint"]"
                              MaxLength="PurchaseInvoice.SupplierNameMaxLength" />
            </MudItem>
        }
        <MudItem xs="12">
            <MudTextField @bind-Value="_note" Label="@L["Cash.Note"]" MaxLength="PurchaseInvoice.NoteMaxLength" />
        </MudItem>
    </MudGrid>
</MudPaper>

<div class="d-flex align-center mb-2 gap-2">
    <MudText Typo="Typo.h6">@L["Purchases.Lines"]</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddLineAsync">
        @L["Purchases.AddLine"]
    </MudButton>
</div>

<MudTable Items="_lines" T="PurchaseEditorLine" Dense="true" Hover="true" Elevation="1" Class="mb-4">
    <HeaderContent>
        <MudTh>@L["Inventory.Product"]</MudTh>
        <MudTh>@L["Products.Unit"]</MudTh>
        <MudTh>@L["Inventory.Quantity"]</MudTh>
        <MudTh>@L["Purchases.BaseQuantity"]</MudTh>
        <MudTh>@L["Purchases.UnitCost"]</MudTh>
        <MudTh>@L["Inventory.BatchNumber"]</MudTh>
        <MudTh>@L["Inventory.ExpiryDate"]</MudTh>
        <MudTh>@L["Purchases.LineTotal"]</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@L["Inventory.Product"]">@context.ProductText</MudTd>
        <MudTd DataLabel="@L["Products.Unit"]">@context.UnitText</MudTd>
        <MudTd DataLabel="@L["Inventory.Quantity"]">@context.Request.Quantity</MudTd>
        <MudTd DataLabel="@L["Purchases.BaseQuantity"]"><b dir="ltr">@context.BaseText</b></MudTd>
        <MudTd DataLabel="@L["Purchases.UnitCost"]"><span dir="ltr">@context.Request.CostPerUnit.ToString("0.00##", CultureInfo.CurrentCulture)</span></MudTd>
        <MudTd DataLabel="@L["Inventory.BatchNumber"]"><span dir="ltr">@context.Request.BatchNumber</span></MudTd>
        <MudTd DataLabel="@L["Inventory.ExpiryDate"]">@(context.Request.ExpiryDate?.ToString("d", CultureInfo.CurrentCulture))</MudTd>
        <MudTd DataLabel="@L["Purchases.LineTotal"]"><span dir="ltr">@MoneyFormat.Format(context.Total)</span></MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           aria-label="@L["Common.Remove"]" title="@L["Common.Remove"]" OnClick="() => _lines.Remove(context)" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>@L["Purchases.NoLines"]</MudText>
    </NoRecordsContent>
</MudTable>

<MudPaper Class="pa-4 mb-4 form-page" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12">
            <MudText Typo="Typo.subtitle2">@L["Purchases.Payment"]</MudText>
            <MudRadioGroup T="PaymentMode" @bind-Value="_mode">
                <MudRadio T="PaymentMode" Value="PaymentMode.Cash" Color="Color.Primary">@L["Purchases.PayCash"]</MudRadio>
                <MudRadio T="PaymentMode" Value="PaymentMode.Credit" Color="Color.Primary" Disabled="@(_supplier is null)">@L["Purchases.PayCredit"]</MudRadio>
                <MudRadio T="PaymentMode" Value="PaymentMode.Mixed" Color="Color.Primary" Disabled="@(_supplier is null)">@L["Purchases.PayMixed"]</MudRadio>
            </MudRadioGroup>
            @if (_supplier is null)
            {
                <MudText Typo="Typo.caption" Class="d-block">@L["Purchases.CreditNeedsSupplier"]</MudText>
            }
            @if (_mode == PaymentMode.Mixed)
            {
                <MudNumericField T="decimal?" @bind-Value="_mixedPaid" Label="@L["Purchases.PaidCash"]" Min="0" Max="Total" Format="0.00" Immediate="true" Class="mt-2" />
            }
        </MudItem>
        <MudItem xs="12">
            <MudSimpleTable Dense="true" Elevation="0">
                <tbody>
                    <tr><td>@L["Purchases.Total"]</td><td dir="ltr"><b>@MoneyFormat.Format(Total)</b></td></tr>
                    <tr><td>@L["Purchases.PaidCash"]</td><td dir="ltr">@MoneyFormat.Format(PaidCash)</td></tr>
                    <tr><td>@L["Purchases.OnCredit"]</td><td dir="ltr">@MoneyFormat.Format(Total - PaidCash)</td></tr>
                </tbody>
            </MudSimpleTable>
        </MudItem>
    </MudGrid>
</MudPaper>

<div class="d-flex justify-end gap-2">
    <MudButton Href="purchases">@L["Common.Cancel"]</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_saving || _lines.Count == 0)" OnClick="SaveAsync">
        @L["Purchases.Post"]
    </MudButton>
</div>

@code {
    private enum PaymentMode
    {
        Cash,
        Credit,
        Mixed,
    }

    // One id per opened form: a double click or a retry posts the invoice only once.
    private readonly Guid _operationId = Guid.NewGuid();
    private readonly List<PurchaseEditorLine> _lines = [];
    private DateTime? _date;
    private SupplierListItem? _supplier;
    private string? _sellerName;
    private string? _supplierInvoiceNumber;
    private string? _note;
    private PaymentMode _mode = PaymentMode.Cash;
    private decimal? _mixedPaid;
    private string? _error;
    private bool _saving;

    [SupplyParameterFromQuery(Name = "supplier")]
    public int? SupplierId { get; set; }

    private decimal Total => _lines.Sum(l => l.Total);

    private decimal PaidCash => _mode switch
    {
        PaymentMode.Cash => Total,
        PaymentMode.Credit => 0m,
        _ => Math.Clamp(_mixedPaid ?? 0m, 0m, Total),
    };

    protected override async Task OnInitializedAsync()
    {
        _date = Clock.GetLocalNow().DateTime.Date;
        if (SupplierId is { } id)
        {
            var detail = await Services.For<SupplierQueryService>().RunAsync(s => s.GetAsync(id));
            if (detail.IsSuccess && detail.Value.IsActive)
            {
                _supplier = new SupplierListItem(detail.Value.Id, detail.Value.Name, detail.Value.Phone, detail.Value.IsActive, detail.Value.Balance);
            }
        }
    }

    private static string SupplierText(SupplierListItem? supplier) => supplier?.Name ?? string.Empty;

    private Task<IEnumerable<SupplierListItem>> SearchSuppliersAsync(string? text, CancellationToken cancellationToken) =>
        TableDataLoader.SearchAsync<SupplierListItem>(async () =>
        {
            var result = await Services.For<SupplierQueryService>().RunAsync(s => s.QuickSearchAsync(text, cancellationToken));
            return result.IsSuccess ? result.Value : Array.Empty<SupplierListItem>();
        }, cancellationToken);

    private void OnSupplierChanged(SupplierListItem? supplier)
    {
        _supplier = supplier;
        if (supplier is null)
        {
            // Debt can only be owed to a registered supplier.
            _mode = PaymentMode.Cash;
        }
    }

    private async Task AddLineAsync()
    {
        var dialog = await DialogService.ShowAsync<PurchaseLineDialog>(
            L["Purchases.AddLine"], new DialogParameters(), new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: PurchaseEditorLine line })
        {
            _lines.Add(line);
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        _saving = true;
        try
        {
            var date = DateOnly.FromDateTime(_date ?? Clock.GetLocalNow().DateTime.Date);
            var request = new PurchaseRequest(
                _operationId, _supplier?.Id, _sellerName, date, _supplierInvoiceNumber, PaidCash, _note, [.. _lines.Select(l => l.Request)]);
            var result = await Services.For<PurchaseService>().RunAsync(s => s.CreateAsync(request));

            if (result.IsFailure)
            {
                _error = L.Message(result.Error!);
                return;
            }

            Snackbar.Add(L["Purchases.Posted"], Severity.Success);
            Navigation.NavigateTo($"purchases/{result.Value}");
        }
        finally
        {
            _saving = false;
        }
    }
}
