@inject ServiceRunner Services

<MudDialog>
    <DialogContent>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }

        <MudText Typo="Typo.body2" Class="mb-3">
            <span dir="ltr">@Batch.BatchNumber</span>
            · @L["Inventory.Sellable"]: @QuantityFormat.Describe(Batch.Available, Units)
            @if (Batch.Quarantined > 0)
            {
                <span> · @L["Inventory.Quarantined"]: @QuantityFormat.Describe(Batch.Quarantined, Units)</span>
            }
        </MudText>

        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudNumericField T="int?" @bind-Value="_quantity" Label="@L["Inventory.Quantity"]" Min="1" Required="true"
                                 RequiredError="@L[InventoryErrors.InvalidQuantity]" />
            </MudItem>
            <MudItem xs="12">
                <MudSelect T="int" @bind-Value="_unitId" Label="@L["Products.Unit"]">
                    @foreach (var unit in Units)
                    {
                        <MudSelectItem T="int" Value="unit.Id">@unit.Unit.For(SupportedCultures.IsArabicUi)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
        @if (SelectedUnit is { IsBase: false } selected && _quantity is > 0)
        {
            <MudText Typo="Typo.caption" Class="d-block mb-2">
                @L["Inventory.BaseEquivalent", _quantity * selected.Factor, BaseUnit?.Unit.For(SupportedCultures.IsArabicUi) ?? string.Empty]
            </MudText>
        }

        @if (Reasons.Count > 0)
        {
            <MudSelect T="string" @bind-Value="_reason" Label="@L["Inventory.Reason"]" Required="@ReasonRequired"
                       RequiredError="@L[InventoryErrors.ReasonRequired]" Clearable="@(!ReasonRequired)">
                @foreach (var reason in Reasons)
                {
                    <MudSelectItem T="string" Value="reason">@L[$"StockReasons.{reason}"]</MudSelectItem>
                }
            </MudSelect>
        }

        <MudTextField @bind-Value="_note" Label="@L["Inventory.Note"]" MaxLength="StockReasons.NoteMaxLength" Lines="2"
                      Required="@(_reason == StockReasons.Other)" RequiredError="@L[InventoryErrors.NoteRequired]" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">@L["Common.Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="@(IsDestructive ? Color.Error : Color.Primary)" Disabled="_saving" OnClick="SaveAsync">
            @L[$"StockActions.{Action}"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public StockAction Action { get; set; }

    [Parameter, EditorRequired]
    public BatchRow Batch { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<ProductUnitSummary> Units { get; set; } = [];

    // One id per opened dialog: a double click or a retry after a network hiccup is applied only once.
    private readonly Guid _operationId = Guid.NewGuid();
    private int _unitId;
    private int? _quantity;
    private string? _reason;
    private string? _note;
    private string? _error;
    private bool _saving;

    private ProductUnitSummary? BaseUnit => Units.FirstOrDefault(u => u.IsBase);

    private ProductUnitSummary? SelectedUnit => Units.FirstOrDefault(u => u.Id == _unitId);

    private bool IsDestructive => Action is StockAction.WriteOff or StockAction.WriteOffQuarantined;

    private bool ReasonRequired => Action != StockAction.Release;

    private IReadOnlyList<string> Reasons => Action switch
    {
        StockAction.AdjustIncrease or StockAction.AdjustDecrease => StockReasons.ForAdjustment,
        StockAction.Quarantine => StockReasons.ForQuarantine,
        StockAction.WriteOff or StockAction.WriteOffQuarantined => StockReasons.ForWriteOff,
        _ => [],
    };

    protected override void OnInitialized()
    {
        _unitId = BaseUnit?.Id ?? Units[0].Id;

        // Writing off an expired batch is by far the most common reason.
        if (Action == StockAction.WriteOff && Batch.Status == ExpiryStatus.Expired)
        {
            _reason = StockReasons.Expired;
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        _saving = true;
        try
        {
            var request = new StockActionRequest(_operationId, Batch.Id, _unitId, _quantity ?? 0, Reasons.Count > 0 ? _reason : null, _note);
            var result = Action switch
            {
                StockAction.AdjustIncrease => await Services.For<InventoryService>().RunAsync(s => s.AdjustAsync(AdjustmentDirection.Increase, request)),
                StockAction.AdjustDecrease => await Services.For<InventoryService>().RunAsync(s => s.AdjustAsync(AdjustmentDirection.Decrease, request)),
                StockAction.Quarantine => await Services.For<InventoryService>().RunAsync(s => s.QuarantineAsync(request)),
                StockAction.Release => await Services.For<InventoryService>().RunAsync(s => s.ReleaseFromQuarantineAsync(request)),
                StockAction.WriteOff => await Services.For<InventoryService>().RunAsync(s => s.WriteOffAsync(fromQuarantine: false, request)),
                _ => await Services.For<InventoryService>().RunAsync(s => s.WriteOffAsync(fromQuarantine: true, request)),
            };

            if (result.IsFailure)
            {
                _error = L.Message(result.Error!);
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _saving = false;
        }
    }
}
