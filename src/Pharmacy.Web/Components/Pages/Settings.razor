@page "/settings"
@attribute [Authorize(Policy = Permissions.SettingsManage)]
@inject ServiceRunner Services
@inject ISnackbar Snackbar

<PageTitle>@L["Settings.Title"] - @L["App.Name"]</PageTitle>

<div class="page-header">
    <MudText Typo="Typo.h4">@L["Settings.Title"]</MudText>
</div>

@if (_form is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    return;
}

<MudForm @ref="_mudForm" Model="_form" Class="settings-page">
    <section class="form-section">
        <div class="section-head">
            <span class="section-icon tone-primary"><MudIcon Icon="@Icons.Material.Filled.LocalPharmacy" /></span>
            <div>
                <h2>@L["Settings.PharmacyInfo"]</h2>
                <p>@L["Settings.PharmacyInfoHint"]</p>
            </div>
        </div>

        <div class="form-stack">
            <MudTextField @bind-Value="_form.NameArabic"
                          Label="@L["Settings.NameArabic"]"
                          Required="true"
                          RequiredError="@L[SettingsErrors.NameArabicRequired]"
                          MaxLength="PharmacySettings.NameMaxLength"
                          Counter="PharmacySettings.NameMaxLength" />

            <MudTextField @bind-Value="_form.NameEnglish"
                          Label="@L["Settings.NameEnglish"]"
                          Required="true"
                          RequiredError="@L[SettingsErrors.NameEnglishRequired]"
                          MaxLength="PharmacySettings.NameMaxLength"
                          Counter="PharmacySettings.NameMaxLength"
                          Style="direction: ltr" />

            <MudTextField @bind-Value="_form.Phone"
                          Label="@L["Settings.Phone"]"
                          InputType="InputType.Telephone"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Phone"
                          MaxLength="PharmacySettings.PhoneMaxLength"
                          Style="direction: ltr" />

            <MudTextField @bind-Value="_form.Address"
                          Label="@L["Settings.Address"]"
                          Lines="3"
                          MaxLength="PharmacySettings.AddressMaxLength"
                          Counter="PharmacySettings.AddressMaxLength" />
        </div>
    </section>

    <section class="form-section">
        <div class="section-head">
            <span class="section-icon tone-secondary"><MudIcon Icon="@Icons.Material.Filled.Palette" /></span>
            <div>
                <h2>@L["Settings.Appearance"]</h2>
                <p>@L["Settings.AppearanceHint"]</p>
            </div>
        </div>

        <div class="choice-label">@L["Settings.ThemeMode"]</div>
        <div class="choice-grid">
            @foreach (var mode in Enum.GetValues<ThemeMode>())
            {
                <button type="button" class="choice @(_form.ThemeMode == mode ? "selected" : string.Empty)" @onclick="() => _form.ThemeMode = mode"
                        aria-pressed="@(_form.ThemeMode == mode)">
                    <MudIcon Icon="@ModeIcon(mode)" />
                    <span>@L[$"Settings.ThemeMode.{mode}"]</span>
                </button>
            }
        </div>

        <div class="choice-label">@L["Settings.PrimaryColor"]</div>
        <div class="color-grid">
            @foreach (var color in Enum.GetValues<ThemeColor>())
            {
                <button type="button" class="color-choice @(_form.PrimaryColor == color ? "selected" : string.Empty)" @onclick="() => _form.PrimaryColor = color"
                        aria-pressed="@(_form.PrimaryColor == color)" title="@L[$"Settings.Color.{color}"]">
                    <span class="swatch" style="background-color: @PharmacyTheme.SwatchFor(color)">
                        @if (_form.PrimaryColor == color)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                        }
                    </span>
                    <span>@L[$"Settings.Color.{color}"]</span>
                </button>
            }
        </div>
    </section>

    <section class="form-section">
        <div class="section-head">
            <span class="section-icon tone-success"><MudIcon Icon="@Icons.Material.Filled.Inventory2" /></span>
            <div>
                <h2>@L["Settings.Inventory"]</h2>
                <p>@L["Settings.InventoryHint"]</p>
            </div>
        </div>

        <div class="form-stack">
            <MudNumericField T="int" @bind-Value="_form.NearExpiryDays" Label="@L["Settings.NearExpiryDays"]"
                             Min="1" Max="PharmacySettings.MaxNearExpiryDays" HelperText="@L["Settings.NearExpiryDaysHint"]"
                             Adornment="Adornment.End" AdornmentText="@L["Settings.DaysUnit"]" />
        </div>
    </section>

    <section class="form-section">
        <div class="section-head">
            <span class="section-icon tone-warning"><MudIcon Icon="@Icons.Material.Filled.PointOfSale" /></span>
            <div>
                <h2>@L["Settings.Sales"]</h2>
                <p>@L["Settings.SalesHint"]</p>
            </div>
        </div>

        <div class="form-stack">
            <MudNumericField T="decimal" @bind-Value="_form.MaxDiscountPercent" Label="@L["Settings.MaxDiscountPercent"]"
                             Min="0" Max="100" Format="0.##" HelperText="@L["Settings.MaxDiscountPercentHint"]"
                             Adornment="Adornment.End" AdornmentText="%" />
            <MudNumericField T="int" @bind-Value="_form.ReturnWindowDays" Label="@L["Settings.ReturnWindowDays"]"
                             Min="0" Max="PharmacySettings.MaxReturnWindowDays" HelperText="@L["Settings.ReturnWindowDaysHint"]"
                             Adornment="Adornment.End" AdornmentText="@L["Settings.DaysUnit"]" />
        </div>
    </section>

    <div class="save-bar">
        <span>@L["Settings.SaveHint"]</span>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="_saving"
                   OnClick="SaveAsync">
            @L["Settings.Save"]
        </MudButton>
    </div>
</MudForm>

@code {
    private MudForm? _mudForm;
    private SettingsForm? _form;
    private byte[] _rowVersion = [];
    private bool _saving;

    private static string ModeIcon(ThemeMode mode) => mode switch
    {
        ThemeMode.Light => Icons.Material.Filled.LightMode,
        ThemeMode.Dark => Icons.Material.Filled.DarkMode,
        _ => Icons.Material.Filled.SettingsBrightness,
    };

    protected override async Task OnInitializedAsync()
    {
        // The page is already restricted by policy; the service checks the permission again.
        var current = await Services.For<PharmacySettingsService>().RunAsync(s => s.GetForEditAsync());
        if (current.IsFailure)
        {
            return;
        }

        _form = SettingsForm.From(current.Value.Values);
        _rowVersion = current.Value.RowVersion;
    }

    private async Task SaveAsync()
    {
        if (_form is null || _mudForm is null)
        {
            return;
        }

        await _mudForm.ValidateAsync();
        if (!_mudForm.IsValid)
        {
            return;
        }

        _saving = true;
        try
        {
            var result = await Services.For<PharmacySettingsService>().RunAsync(s => s.UpdateAsync(_form.ToData(), _rowVersion));
            if (result.IsFailure)
            {
                var error = result.Error!;
                Snackbar.Add(L[error.Code, [.. error.Arguments]], Severity.Error);
                return;
            }

            // Reload so the next save carries the new concurrency token.
            var reloaded = await Services.For<PharmacySettingsService>().RunAsync(s => s.GetForEditAsync());
            if (reloaded.IsSuccess)
            {
                _rowVersion = reloaded.Value.RowVersion;
            }

            Snackbar.Add(L["Settings.Saved"], Severity.Success);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>Mutable form model; the domain record stays immutable.</summary>
    private sealed class SettingsForm
    {
        public string NameArabic { get; set; } = string.Empty;
        public string NameEnglish { get; set; } = string.Empty;
        public string? Phone { get; set; }
        public string? Address { get; set; }
        public ThemeMode ThemeMode { get; set; }
        public ThemeColor PrimaryColor { get; set; }
        public int NearExpiryDays { get; set; }
        public decimal MaxDiscountPercent { get; set; }
        public int ReturnWindowDays { get; set; }

        public static SettingsForm From(PharmacySettingsData data) => new()
        {
            NameArabic = data.NameArabic,
            NameEnglish = data.NameEnglish,
            Phone = data.Phone,
            Address = data.Address,
            ThemeMode = data.ThemeMode,
            PrimaryColor = data.PrimaryColor,
            NearExpiryDays = data.NearExpiryDays,
            MaxDiscountPercent = data.MaxDiscountPercent,
            ReturnWindowDays = data.ReturnWindowDays,
        };

        public PharmacySettingsData ToData() =>
            new(NameArabic, NameEnglish, Phone, Address, ThemeMode, PrimaryColor, NearExpiryDays, MaxDiscountPercent, ReturnWindowDays);
    }
}
