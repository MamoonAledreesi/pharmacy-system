@page "/Account/ChangePassword"
@using Microsoft.AspNetCore.Identity
@using Pharmacy.Infrastructure.Identity
@inject IAccountService AccountService
@inject CurrentUserAccessor CurrentUser
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation

<PageTitle>@L["ChangePassword.Title"] - @L["App.Name"]</PageTitle>

<h1 class="account-title">@L["ChangePassword.Title"]</h1>

@if (_mustChange)
{
    <p class="account-hint">@L["ChangePassword.Required"]</p>
}

<AccountError Message="@_error" />

<EditForm Model="Input" method="post" OnSubmit="ChangeAsync" FormName="change-password" class="account-form">
    <label class="account-label" for="current-password">@L["ChangePassword.Current"]</label>
    <InputText id="current-password" type="password" class="account-input" @bind-Value="Input.CurrentPassword" autocomplete="current-password" dir="ltr" autofocus />

    <label class="account-label" for="new-password">@L["ChangePassword.New"]</label>
    <InputText id="new-password" type="password" class="account-input" @bind-Value="Input.NewPassword" autocomplete="new-password" dir="ltr" />

    <label class="account-label" for="confirm-password">@L["Account.ConfirmPassword"]</label>
    <InputText id="confirm-password" type="password" class="account-input" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" dir="ltr" />

    <p class="account-hint">@L["Account.PasswordPolicy", UserRules.PasswordMinLength]</p>

    <button type="submit" class="account-button">@L["ChangePassword.Submit"]</button>
</EditForm>

@if (!_mustChange)
{
    <a class="account-link" href="/">@L["NotFound.BackHome"]</a>
}

@code {
    private string? _error;
    private bool _mustChange;

    [SupplyParameterFromForm]
    private ChangePasswordInput Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
        _mustChange = CurrentUser.Principal.HasClaim(PharmacyClaimTypes.MustChangePassword, "true");
    }

    private async Task ChangeAsync()
    {
        var (current, newPassword, confirmation) = (Input.CurrentPassword, Input.NewPassword, Input.ConfirmPassword);
        // Never echo a password back into the re-rendered form.
        (Input.CurrentPassword, Input.NewPassword, Input.ConfirmPassword) = (string.Empty, string.Empty, string.Empty);

        if (string.IsNullOrEmpty(current) || string.IsNullOrEmpty(newPassword))
        {
            _error = L["Account.FieldsRequired"];
            return;
        }

        if (newPassword != confirmation)
        {
            _error = L["Account.PasswordsDoNotMatch"];
            return;
        }

        var result = await AccountService.ChangePasswordAsync(CurrentUser.UserId!.Value, current, newPassword);
        if (result.IsFailure)
        {
            _error = L.Message(result.Error!);
            return;
        }

        // The password change rotated the security stamp; issue a fresh cookie without the temporary-password flag.
        var user = await UserManager.GetUserAsync(CurrentUser.Principal);
        await SignInManager.RefreshSignInAsync(user!);
        Navigation.NavigateTo("/");
    }

    private sealed class ChangePasswordInput
    {
        public string CurrentPassword { get; set; } = string.Empty;

        public string NewPassword { get; set; } = string.Empty;

        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
