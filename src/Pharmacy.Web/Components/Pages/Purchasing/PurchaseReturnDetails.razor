@page "/purchases/returns/{ReturnId:int}"
@attribute [Authorize(Policy = Permissions.PurchasingView)]
@inject ServiceRunner Services

<PageTitle>@L["Purchases.ReturnTitle"] - @L["App.Name"]</PageTitle>

<div class="page-header">
    <MudIconButton Icon="@(SupportedCultures.IsArabicUi ? Icons.Material.Filled.ArrowForward : Icons.Material.Filled.ArrowBack)"
                   Href="purchases/returns" aria-label="@L["Products.BackToList"]" title="@L["Products.BackToList"]" />
    <MudText Typo="Typo.h4">@L["Purchases.ReturnTitle"] <span dir="ltr">@_return?.Number</span></MudText>
</div>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning">@L["Errors.NotFound"]</MudAlert>
    return;
}

@if (_return is not { } purchaseReturn)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    return;
}

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <MudSimpleTable Dense="true" Elevation="0">
                <tbody>
                    <tr><td>@L["Audit.Time"]</td><td>@LocalizerExtensions.LocalTime(purchaseReturn.CreatedAtUtc)</td></tr>
                    <tr><td>@L["Purchases.Invoice"]</td><td><MudLink Href="@($"purchases/{purchaseReturn.InvoiceId}")"><span dir="ltr">@purchaseReturn.InvoiceNumber</span></MudLink></td></tr>
                    <tr>
                        <td>@L["Purchases.Supplier"]</td>
                        <td>
                            @if (purchaseReturn.SupplierId is { } supplierId)
                            {
                                <MudLink Href="@($"suppliers/{supplierId}")">@purchaseReturn.SupplierName</MudLink>
                            }
                            else
                            {
                                @(purchaseReturn.SupplierName ?? L["Purchases.UnregisteredSeller"])
                            }
                        </td>
                    </tr>
                    <tr><td>@L["Purchases.ReturnReason"]</td><td>@purchaseReturn.Reason</td></tr>
                    <tr><td>@L["Purchases.EnteredBy"]</td><td dir="ltr">@purchaseReturn.UserName</td></tr>
                </tbody>
            </MudSimpleTable>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSimpleTable Dense="true" Elevation="0">
                <tbody>
                    <tr><td><b>@L["Purchases.Total"]</b></td><td dir="ltr"><b>@MoneyFormat.Format(purchaseReturn.Total)</b></td></tr>
                    <tr><td>@L["Purchases.DebtReduction"]</td><td dir="ltr">@MoneyFormat.Format(purchaseReturn.DebtReduction)</td></tr>
                    <tr><td>@L["Purchases.CashReceived"]</td><td dir="ltr">@MoneyFormat.Format(purchaseReturn.CashRefund)</td></tr>
                </tbody>
            </MudSimpleTable>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable Items="purchaseReturn.Lines" T="PurchaseReturnLineDetail" Dense="true" Hover="true" Elevation="1">
    <HeaderContent>
        <MudTh>@L["Inventory.Product"]</MudTh>
        <MudTh>@L["Inventory.BatchNumber"]</MudTh>
        <MudTh>@L["Products.Unit"]</MudTh>
        <MudTh>@L["Inventory.Quantity"]</MudTh>
        <MudTh>@L["Sales.ReturnValue"]</MudTh>
        <MudTh>@L["Purchases.FromQuarantine"]</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@L["Inventory.Product"]">@context.Product.For(SupportedCultures.IsArabicUi) @context.Strength</MudTd>
        <MudTd DataLabel="@L["Inventory.BatchNumber"]"><span dir="ltr">@context.BatchNumber</span></MudTd>
        <MudTd DataLabel="@L["Products.Unit"]">@context.Unit.For(SupportedCultures.IsArabicUi)</MudTd>
        <MudTd DataLabel="@L["Inventory.Quantity"]">@context.Quantity</MudTd>
        <MudTd DataLabel="@L["Sales.ReturnValue"]"><span dir="ltr">@MoneyFormat.Format(context.Value)</span></MudTd>
        <MudTd DataLabel="@L["Purchases.FromQuarantine"]">
            @if (context.FromQuarantine)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["Purchases.FromQuarantine"]</MudChip>
            }
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private PurchaseReturnDetail? _return;
    private bool _notFound;

    [Parameter]
    public int ReturnId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var result = await Services.For<PurchaseReturnQueryService>().RunAsync(s => s.GetAsync(ReturnId));
        _notFound = result.IsFailure;
        _return = result.IsSuccess ? result.Value : null;
    }
}
