@typeparam TLookup where TLookup : NamedLookup, new()
@inject ServiceRunner Services

<MudDialog>
    <DialogContent>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }

        <MudTextField @bind-Value="_nameArabic" Label="@L["Catalog.NameArabic"]" Required="true"
                      RequiredError="@L[CatalogErrors.NameArabicRequired]" MaxLength="NamedLookup.NameMaxLength" />
        <MudTextField @bind-Value="_nameEnglish" Label="@L["Catalog.NameEnglish"]" Required="true"
                      RequiredError="@L[CatalogErrors.NameEnglishRequired]" MaxLength="NamedLookup.NameMaxLength" Style="direction: ltr" />
        @if (Item is not null)
        {
            <MudSwitch @bind-Value="_isActive" Color="Color.Primary" Label="@L["Users.Active"]" Class="mt-3" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">@L["Common.Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="SaveAsync">@L["Settings.Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Null when adding a new item.</summary>
    [Parameter]
    public LookupItem? Item { get; set; }

    private string _nameArabic = string.Empty;
    private string _nameEnglish = string.Empty;
    private bool _isActive = true;
    private string? _error;
    private bool _saving;

    protected override void OnInitialized()
    {
        if (Item is not null)
        {
            (_nameArabic, _nameEnglish, _isActive) = (Item.NameArabic, Item.NameEnglish, Item.IsActive);
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var result = Item is null
                ? await Services.For<LookupService<TLookup>>().RunAsync(s => s.CreateAsync(_nameArabic, _nameEnglish))
                : await Services.For<LookupService<TLookup>>().RunAsync(s => s.UpdateAsync(Item.Id, _nameArabic, _nameEnglish, _isActive));

            if (result.IsFailure)
            {
                _error = L.Message(result.Error!);
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _saving = false;
        }
    }
}
