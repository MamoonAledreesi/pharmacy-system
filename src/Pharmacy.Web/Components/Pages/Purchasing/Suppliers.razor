@page "/suppliers"
@attribute [Authorize(Policy = Permissions.SuppliersView)]
@inject ServiceRunner Services
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@L["Nav.Suppliers"] - @L["App.Name"]</PageTitle>

<div class="d-flex align-center mb-4 gap-2">
    <MudText Typo="Typo.h4">@L["Nav.Suppliers"]</MudText>
    <MudSpacer />
    <AuthorizeView Policy="@Permissions.SuppliersManage">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">
            @L["Suppliers.Add"]
        </MudButton>
    </AuthorizeView>
</div>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="8">
            <MudTextField T="string" Value="_searchText" ValueChanged="OnSearchChangedAsync" Immediate="true" DebounceInterval="300"
                          Label="@L["Suppliers.Search"]" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" autofocus />
        </MudItem>
        <MudItem xs="12" md="4" Class="d-flex align-center">
            <MudSwitch T="bool" Value="_includeInactive" ValueChanged="OnIncludeInactiveChangedAsync" Color="Color.Primary" Label="@L["Suppliers.ShowInactive"]" />
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable @ref="_table" T="SupplierListItem" ServerData="LoadAsync" Dense="true" Hover="true" Elevation="1" RowsPerPage="25"
          OnRowClick="args => Open(args.Item!)" RowClass="cursor-pointer">
    <HeaderContent>
        <MudTh>@L["Suppliers.Name"]</MudTh>
        <MudTh>@L["Suppliers.Phone"]</MudTh>
        <MudTh>@L["Suppliers.Balance"]</MudTh>
        <MudTh>@L["Users.Status"]</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@L["Suppliers.Name"]"><b>@context.Name</b></MudTd>
        <MudTd DataLabel="@L["Suppliers.Phone"]"><span dir="ltr">@context.Phone</span></MudTd>
        <MudTd DataLabel="@L["Suppliers.Balance"]">
            <span dir="ltr" class="@(context.Balance > 0 ? "delta-negative" : string.Empty)">@MoneyFormat.Format(context.Balance)</span>
        </MudTd>
        <MudTd DataLabel="@L["Users.Status"]">
            @if (!context.IsActive)
            {
                <MudChip T="string" Size="Size.Small">@L["Users.Inactive"]</MudChip>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>@L["Suppliers.NoResults"]</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="[25, 50, 100]" RowsPerPageString="@L["Pager.RowsPerPage"]" InfoFormat="@L["Pager.InfoFormat"]" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<SupplierListItem>? _table;
    private string? _searchText;
    private bool _includeInactive;

    private Task<TableData<SupplierListItem>> LoadAsync(TableState state, CancellationToken cancellationToken) =>
        TableDataLoader.LoadAsync(() => LoadPageAsync(state, cancellationToken), cancellationToken);

    private async Task<TableData<SupplierListItem>> LoadPageAsync(TableState state, CancellationToken cancellationToken)
    {
        var result = await Services.For<SupplierQueryService>().RunAsync(s => s.SearchAsync(
            new SupplierQuery(_searchText, _includeInactive, state.Page, state.PageSize), cancellationToken));
        return result.IsSuccess
            ? new TableData<SupplierListItem> { Items = result.Value.Items, TotalItems = result.Value.TotalCount }
            : new TableData<SupplierListItem> { Items = [], TotalItems = 0 };
    }

    private Task OnSearchChangedAsync(string? text)
    {
        _searchText = text;
        return ReloadAsync();
    }

    private Task OnIncludeInactiveChangedAsync(bool include)
    {
        _includeInactive = include;
        return ReloadAsync();
    }

    private Task ReloadAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;

    private void Open(SupplierListItem supplier) => Navigation.NavigateTo($"suppliers/{supplier.Id}");

    private async Task AddAsync()
    {
        var dialog = await DialogService.ShowAsync<SupplierDialog>(
            L["Suppliers.Add"], new DialogParameters(), new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(L["Common.Saved"], Severity.Success);
            await ReloadAsync();
        }
    }
}
