@page "/reports/{Key}"
@attribute [Authorize(Policy = Permissions.ReportsView)]
@inject ServiceRunner Services
@inject ReportDocumentBuilder Builder
@inject TimeProvider Clock
@inject IJSRuntime JS

<PageTitle>@Title - @L["App.Name"]</PageTitle>

<div class="page-header">
    <MudIconButton Icon="@(SupportedCultures.IsArabicUi ? Icons.Material.Filled.ArrowForward : Icons.Material.Filled.ArrowBack)"
                   Href="reports" aria-label="@L["Reports.BackToList"]" title="@L["Reports.BackToList"]" />
    @if (_definition is not null)
    {
        <span class="report-icon @ReportStyle.ToneOf(_definition.Group)"><MudIcon Icon="@ReportStyle.IconOf(_reportKey)" /></span>
    }
    <MudText Typo="Typo.h4">@Title</MudText>
</div>

@if (_definition is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@L["Errors.NotFound"]</MudAlert>
    return;
}

<p class="report-intro">@L[$"Reports.Description.{_reportKey}"]</p>

<MudPaper Class="report-filters" Elevation="1">
    @if (Has(ReportFilters.Period))
    {
        <MudDatePicker @bind-Date="_from" Label="@L["Purchases.From"]" Class="report-field" />
        <MudDatePicker @bind-Date="_to" Label="@L["Purchases.To"]" Class="report-field" />
    }
    @if (Has(ReportFilters.Customer))
    {
        <MudAutocomplete T="CustomerListItem" Label="@L["Sales.Customer"]" @bind-Value="_customer" SearchFunc="SearchCustomersAsync" Class="report-field wide"
                         ToStringFunc="@(c => c?.Name ?? string.Empty)" MinCharacters="0" DebounceInterval="250" CoerceText="false" />
    }
    @if (Has(ReportFilters.Supplier))
    {
        <MudAutocomplete T="SupplierListItem" Label="@L["Purchases.Supplier"]" @bind-Value="_supplier" SearchFunc="SearchSuppliersAsync" Class="report-field wide"
                         ToStringFunc="@(s => s?.Name ?? string.Empty)" MinCharacters="0" DebounceInterval="250" CoerceText="false" />
    }
    @if (Has(ReportFilters.ExpenseCategory))
    {
        <MudSelect T="int?" @bind-Value="_categoryId" Label="@L["Expenses.Category"]" Clearable="true" Class="report-field">
            @foreach (var category in _categories)
            {
                <MudSelectItem T="int?" Value="category.Id">@category.DisplayName(SupportedCultures.IsArabicUi)</MudSelectItem>
            }
        </MudSelect>
    }
    @if (Has(ReportFilters.Text))
    {
        <MudTextField T="string" @bind-Value="_text" Label="@L["Reports.Filter.Text"]" Clearable="true" Immediate="false" Class="report-field wide"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
    }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunAsync" Disabled="_running" StartIcon="@Icons.Material.Filled.PlayArrow"
               Class="report-run" data-test="run-report">
        @L["Reports.Run"]
    </MudButton>
</MudPaper>

@if (_running)
{
    <MudProgressLinear Indeterminate="true" Class="mb-3" />
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_error</MudAlert>
}

@if (_document is { } document)
{
    @if (document.Columns.Count > 6)
    {
        <style>@@page { size: A4 landscape; margin: 10mm; }</style>
    }

    <MudPaper Class="report-result" Elevation="1">
        <div class="print-only report-print-head">
            <div class="print-pharmacy">@document.PharmacyName</div>
            <div class="print-title">@document.Title</div>
            <div class="print-filters">@string.Join("   |   ", document.Filters.Select(f => $"{f.Label}: {f.Value}"))</div>
            <div class="print-generated">@document.GeneratedAt</div>
        </div>
        <div class="report-toolbar">
            <div class="report-meta">
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.TableRows">
                    @string.Format(CultureInfo.CurrentCulture, L["Reports.RowsCount"].Value, document.Rows.Count)
                </MudChip>
                <span class="report-generated">@document.GeneratedAt</span>
            </div>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintAsync" data-test="print-report">
                @L["Sales.Print"]
            </MudButton>
            <AuthorizeView Policy="@Permissions.ReportsExport">
                <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.TableChart"
                           Href="@ExportUrl(ReportEndpoints.ExcelFormat)" download="true" data-test="export-excel">
                    @L["Reports.ExportExcel"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                           Href="@ExportUrl(ReportEndpoints.PdfFormat)" download="true" data-test="export-pdf">
                    @L["Reports.ExportPdf"]
                </MudButton>
            </AuthorizeView>
        </div>

        @if (document.Rows.Count == 0)
        {
            <div class="empty-state">
                <MudIcon Icon="@Icons.Material.Filled.FolderOff" Size="Size.Large" />
                <span>@L["Reports.NoData"]</span>
            </div>
        }
        else
        {
            <div class="report-table-wrap">
                <table class="report-table @(document.Columns.Count <= 4 ? "compact" : string.Empty)">
                    <thead>
                        <tr>
                            @foreach (var column in document.Columns)
                            {
                                <th class="@NumberClass(column.Kind)">@column.Header</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var r = 0; r < document.Rows.Count && r < DisplayLimit; r++)
                        {
                            var row = document.Rows[r];
                            <tr class="@(IsStrongRow(r) ? "row-strong" : string.Empty)">
                                @for (var c = 0; c < document.Columns.Count; c++)
                                {
                                    <td class="@NumberClass(document.Columns[c].Kind)">@Cell(row[c], document.Columns[c].Kind)</td>
                                }
                            </tr>
                        }
                    </tbody>
                    @if (document.Totals is { } totals)
                    {
                        <tfoot>
                            <tr>
                                @for (var c = 0; c < document.Columns.Count; c++)
                                {
                                    <td class="@NumberClass(document.Columns[c].Kind)">@Cell(totals[c], document.Columns[c].Kind)</td>
                                }
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>

            @if (document.Rows.Count > DisplayLimit)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="ma-3">
                    @string.Format(CultureInfo.CurrentCulture, L["Reports.DisplayLimit"].Value, DisplayLimit)
                </MudAlert>
            }
        }
    </MudPaper>
}

@code {
    // Rendering tens of thousands of rows in the browser would freeze it; the export always has every row.
    private const int DisplayLimit = 500;

    private ReportDefinition? _definition;
    private ReportKey _reportKey;
    private ReportDocument? _document;
    private IReadOnlyList<LookupItem> _categories = [];
    private DateTime? _from;
    private DateTime? _to;
    private CustomerListItem? _customer;
    private SupplierListItem? _supplier;
    private int? _categoryId;
    private string? _text;
    private string? _error;
    private bool _running;

    [Parameter]
    public string Key { get; set; } = string.Empty;

    private string Title => _definition is null ? L["Nav.Reports"] : L[$"Reports.Title.{_reportKey}"];

    protected override async Task OnParametersSetAsync()
    {
        _document = null;
        _error = null;
        _definition = Enum.TryParse<ReportKey>(Key, ignoreCase: true, out var key) && Enum.IsDefined(key) ? ReportDefinitions.Find(key) : null;
        if (_definition is null)
        {
            return;
        }

        _reportKey = _definition.Key;

        // The month so far is what people look at first.
        var today = Clock.GetLocalNow().DateTime.Date;
        _from = new DateTime(today.Year, today.Month, 1);
        _to = today;

        if (Has(ReportFilters.ExpenseCategory))
        {
            var categories = await Services.For<ExpenseCategoryService>().RunAsync(s => s.GetAllAsync(includeInactive: true));
            _categories = categories.IsSuccess ? categories.Value : [];
        }

        // A statement needs a customer or supplier first; the others can be shown right away.
        if (!Has(ReportFilters.Customer) && !Has(ReportFilters.Supplier))
        {
            await RunAsync();
        }
    }

    private bool Has(ReportFilters filter) => _definition is not null && _definition.Filters.HasFlag(filter);

    private ReportRequest BuildRequest() => new(
        _reportKey,
        _from is { } from ? DateOnly.FromDateTime(from) : null,
        _to is { } to ? DateOnly.FromDateTime(to) : null,
        _customer?.Id,
        _supplier?.Id,
        _categoryId,
        _text);

    private async Task PrintAsync() => await JS.InvokeVoidAsync("print");

    private async Task RunAsync()
    {
        _error = null;
        _running = true;
        try
        {
            var request = BuildRequest();
            var result = await Services.For<ReportService>().RunAsync(s => s.RunAsync(request));
            if (result.IsFailure)
            {
                _document = null;
                _error = L.Message(result.Error!);
                return;
            }

            _document = Builder.Build(result.Value);
        }
        finally
        {
            _running = false;
        }
    }

    // The export repeats the filters the report on screen was run with.
    private string ExportUrl(string format)
    {
        var request = BuildRequest();
        var query = new List<string> { $"format={format}" };
        if (Has(ReportFilters.Period))
        {
            query.Add($"from={request.From:yyyy-MM-dd}");
            query.Add($"to={request.To:yyyy-MM-dd}");
        }

        if (request.CustomerId is { } customerId)
        {
            query.Add($"customerId={customerId}");
        }

        if (request.SupplierId is { } supplierId)
        {
            query.Add($"supplierId={supplierId}");
        }

        if (request.CategoryId is { } categoryId)
        {
            query.Add($"categoryId={categoryId}");
        }

        if (!string.IsNullOrWhiteSpace(request.Text))
        {
            query.Add($"text={Uri.EscapeDataString(request.Text)}");
        }

        return $"reports/{_reportKey}/export?{string.Join('&', query)}";
    }

    private Task<IEnumerable<CustomerListItem>> SearchCustomersAsync(string? text, CancellationToken cancellationToken) =>
        TableDataLoader.SearchAsync<CustomerListItem>(async () =>
        {
            var result = await Services.For<CustomerQueryService>().RunAsync(s => s.QuickSearchAsync(text, cancellationToken));
            return result.IsSuccess ? result.Value : Array.Empty<CustomerListItem>();
        }, cancellationToken);

    private Task<IEnumerable<SupplierListItem>> SearchSuppliersAsync(string? text, CancellationToken cancellationToken) =>
        TableDataLoader.SearchAsync<SupplierListItem>(async () =>
        {
            var result = await Services.For<SupplierQueryService>().RunAsync(s => s.QuickSearchAsync(text, cancellationToken));
            return result.IsSuccess ? result.Value : Array.Empty<SupplierListItem>();
        }, cancellationToken);

    private static string NumberClass(ReportColumnKind kind) =>
        kind is ReportColumnKind.Integer or ReportColumnKind.Money or ReportColumnKind.Percent ? "num" : string.Empty;

    // The profit statement stresses its subtotals: net sales, gross profit and operating profit.
    private bool IsStrongRow(int index) => _reportKey == ReportKey.Profit && index is 2 or 4 or 8;

    private static RenderFragment Cell(object? value, ReportColumnKind kind) => value switch
    {
        null => builder => { },
        string text => builder => builder.AddContent(0, text),
        int number => Number(number.ToString("N0", CultureInfo.CurrentCulture)),
        decimal amount when kind == ReportColumnKind.Percent => Number((amount < 0 ? "-" : string.Empty) + Math.Abs(amount).ToString("0.0", CultureInfo.InvariantCulture) + "%", amount < 0),
        decimal amount => Number(MoneyFormat.Format(amount), amount < 0),
        DateOnly day => Number(day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)),
        DateTime moment => Number(moment.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)),
        _ => builder => builder.AddContent(0, Convert.ToString(value, CultureInfo.CurrentCulture)),
    };

    // Numbers and dates stay left-to-right inside right-to-left text.
    private static RenderFragment Number(string text, bool negative = false) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "dir", "ltr");
        builder.AddAttribute(2, "class", negative ? "neg" : null);
        builder.AddContent(3, text);
        builder.CloseElement();
    };
}
