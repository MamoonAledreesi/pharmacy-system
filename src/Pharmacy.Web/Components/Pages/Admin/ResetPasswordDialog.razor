@inject IUserManagementService UserManagement

<MudDialog>
    <DialogContent>
        <MudText Class="mb-2">@L["Users.ResetPasswordFor", User.FullName]</MudText>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }

        <MudTextField @bind-Value="_temporaryPassword" Label="@L["Users.TemporaryPassword"]"
                      HelperText="@L["Account.PasswordPolicy", UserRules.PasswordMinLength]" Style="direction: ltr" />
        <MudText Typo="Typo.caption" Class="mt-2">@L["Users.ResetPasswordHint"]</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Common.Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="ResetAsync">@L["Users.ResetPassword"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public UserSummary User { get; set; } = default!;

    private string _temporaryPassword = string.Empty;
    private string? _error;
    private bool _saving;

    private async Task ResetAsync()
    {
        _saving = true;
        try
        {
            var result = await UserManagement.ResetPasswordAsync(User.Id, _temporaryPassword);
            if (result.IsFailure)
            {
                _error = L.Message(result.Error!);
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
