@page "/purchases/{InvoiceId:int}/return"
@attribute [Authorize(Policy = Permissions.PurchasingReturn)]
@inject ServiceRunner Services
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@L["Purchases.ReturnTitle"] - @L["App.Name"]</PageTitle>

<div class="d-flex align-center mb-4 gap-2">
    <MudIconButton Icon="@(SupportedCultures.IsArabicUi ? Icons.Material.Filled.ArrowForward : Icons.Material.Filled.ArrowBack)"
                   Href="@($"purchases/{InvoiceId}")" aria-label="@L["Products.BackToList"]" title="@L["Products.BackToList"]" />
    <MudText Typo="Typo.h4">@L["Purchases.ReturnTitle"] <span dir="ltr">@_invoice?.Number</span></MudText>
</div>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning">@L["Errors.NotFound"]</MudAlert>
    return;
}

@if (_invoice is not { } invoice)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    return;
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
}

<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudText Typo="Typo.body2">@L["Purchases.Supplier"]: <b>@(invoice.SupplierName ?? L["Purchases.UnregisteredSeller"])</b></MudText>
    <MudText Typo="Typo.body2">@L["Purchases.Total"]: <b dir="ltr">@MoneyFormat.Format(invoice.Total)</b> · @L["Purchases.OnCredit"]: <b dir="ltr">@MoneyFormat.Format(invoice.OnCredit)</b></MudText>
</MudPaper>

<MudTable Items="_rows" T="ReturnRow" Dense="true" Hover="true" Elevation="1" Class="mb-3">
    <HeaderContent>
        <MudTh>@L["Inventory.Product"]</MudTh>
        <MudTh>@L["Inventory.BatchNumber"]</MudTh>
        <MudTh>@L["Purchases.Received"]</MudTh>
        <MudTh>@L["Purchases.CanReturn"]</MudTh>
        <MudTh>@L["Purchases.BatchHolds"]</MudTh>
        <MudTh>@L["Sales.ReturnQuantity"]</MudTh>
        <MudTh>@L["Products.Unit"]</MudTh>
        <MudTh>@L["Purchases.FromQuarantine"]</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@L["Inventory.Product"]">@context.Line.Product.For(SupportedCultures.IsArabicUi) @context.Line.Strength</MudTd>
        <MudTd DataLabel="@L["Inventory.BatchNumber"]"><span dir="ltr">@context.Line.BatchNumber</span></MudTd>
        <MudTd DataLabel="@L["Purchases.Received"]">@context.Line.ReceivedQuantity @context.Line.ReceivedUnit.For(SupportedCultures.IsArabicUi)</MudTd>
        <MudTd DataLabel="@L["Purchases.CanReturn"]">@context.Line.RemainingBaseQuantity</MudTd>
        <MudTd DataLabel="@L["Purchases.BatchHolds"]"><span dir="ltr">@context.Line.BatchAvailable / @context.Line.BatchQuarantined</span></MudTd>
        <MudTd DataLabel="@L["Sales.ReturnQuantity"]">
            <MudNumericField T="int?" @bind-Value="context.Quantity" Min="0" Disabled="@(context.Line.RemainingBaseQuantity == 0)" Style="max-width: 6rem" />
        </MudTd>
        <MudTd DataLabel="@L["Products.Unit"]">
            <MudSelect T="int" @bind-Value="context.UnitId" Disabled="@(context.Line.RemainingBaseQuantity == 0)">
                @foreach (var unit in context.Line.Units)
                {
                    <MudSelectItem T="int" Value="unit.Id">@unit.Unit.For(SupportedCultures.IsArabicUi)</MudSelectItem>
                }
            </MudSelect>
        </MudTd>
        <MudTd DataLabel="@L["Purchases.FromQuarantine"]">
            <MudSwitch T="bool" @bind-Value="context.FromQuarantine" Color="Color.Primary" Disabled="@(context.Line.RemainingBaseQuantity == 0)"
                       aria-label="@L["Purchases.FromQuarantine"]" />
        </MudTd>
    </RowTemplate>
</MudTable>

<MudTextField @bind-Value="_reason" Label="@L["Purchases.ReturnReason"]" MaxLength="PurchaseReturn.ReasonMaxLength" Lines="2" Required="true" Class="mb-3" />

<div class="d-flex justify-end gap-2">
    <MudButton Href="@($"purchases/{InvoiceId}")">@L["Common.Cancel"]</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               Disabled="@(_saving || !_rows.Any(r => r.Quantity is > 0) || string.IsNullOrWhiteSpace(_reason))" OnClick="ReviewAsync">
        @L["Sales.ReviewReturn"]
    </MudButton>
</div>

@code {
    // One id per opened form: a double click or a retry posts the return only once.
    private readonly Guid _operationId = Guid.NewGuid();
    private readonly List<ReturnRow> _rows = [];
    private PurchaseReturnableInvoice? _invoice;
    private string? _reason;
    private string? _error;
    private bool _notFound;
    private bool _saving;

    [Parameter]
    public int InvoiceId { get; set; }

    private sealed class ReturnRow(PurchaseReturnableLine line, int unitId)
    {
        public PurchaseReturnableLine Line { get; } = line;

        public int? Quantity { get; set; }

        public int UnitId { get; set; } = unitId;

        /// <summary>Goods go back from the shelf stock unless the user says they come from quarantine.</summary>
        public bool FromQuarantine { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        var result = await Services.For<PurchaseReturnQueryService>().RunAsync(s => s.GetReturnableAsync(InvoiceId));
        _notFound = result.IsFailure;
        _invoice = result.IsSuccess ? result.Value : null;
        _rows.Clear();
        if (_invoice is not null)
        {
            _rows.AddRange(_invoice.Lines.Select(line => new ReturnRow(line, line.Units.FirstOrDefault(u => u.IsBase)?.Id ?? line.Units[0].Id)));
        }
    }

    private PurchaseReturnRequest BuildRequest() => new(
        _operationId,
        InvoiceId,
        [.. _rows.Where(r => r.Quantity is > 0).Select(r => new PurchaseReturnLineRequest(r.Line.InvoiceLineId, r.UnitId, r.Quantity!.Value, r.FromQuarantine))],
        _reason);

    // Shows what the return will do (less owed to the supplier and cash received) and asks for confirmation before posting.
    private async Task ReviewAsync()
    {
        _error = null;
        _saving = true;
        try
        {
            var request = BuildRequest();
            var preview = await Services.For<PurchaseReturnService>().RunAsync(s => s.PreviewAsync(request));
            if (preview.IsFailure)
            {
                _error = L.Message(preview.Error!);
                return;
            }

            var summary = preview.Value;
            var confirmed = await DialogService.ShowMessageBoxAsync(
                L["Sales.ReturnConfirmTitle"],
                L["Purchases.ReturnConfirmText", MoneyFormat.Format(summary.Total), MoneyFormat.Format(summary.DebtReduction), MoneyFormat.Format(summary.CashRefund)].Value,
                yesText: L["Sales.ReturnConfirmYes"],
                cancelText: L["Common.Cancel"]);
            if (confirmed != true)
            {
                return;
            }

            var result = await Services.For<PurchaseReturnService>().RunAsync(s => s.CreateAsync(request));
            if (result.IsFailure)
            {
                _error = L.Message(result.Error!);
                return;
            }

            Snackbar.Add(L["Sales.ReturnPosted"], Severity.Success);
            Navigation.NavigateTo($"purchases/returns/{result.Value}");
        }
        finally
        {
            _saving = false;
        }
    }
}
