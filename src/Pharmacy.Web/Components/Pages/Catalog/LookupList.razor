@typeparam TLookup where TLookup : NamedLookup, new()
@inject ServiceRunner Services
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<AuthorizeView Policy="@Permissions.CatalogManage">
    <MudButton Class="mb-3" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => EditAsync(null)">
        @L["Catalog.AddItem"]
    </MudButton>
</AuthorizeView>

<MudTable Items="_items" Dense="true" Hover="true" Loading="_loading" Elevation="0">
    <HeaderContent>
        <MudTh>@L["Catalog.NameArabic"]</MudTh>
        <MudTh>@L["Catalog.NameEnglish"]</MudTh>
        <MudTh>@L["Users.Status"]</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@L["Catalog.NameArabic"]">@context.NameArabic</MudTd>
        <MudTd DataLabel="@L["Catalog.NameEnglish"]"><span dir="ltr">@context.NameEnglish</span></MudTd>
        <MudTd DataLabel="@L["Users.Status"]">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                @(context.IsActive ? L["Users.Active"] : L["Users.Inactive"])
            </MudChip>
        </MudTd>
        <MudTd>
            <AuthorizeView Policy="@Permissions.CatalogManage" Context="_">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@L["Catalog.EditItem"]"
                               title="@L["Catalog.EditItem"]" OnClick="() => EditAsync(context)" />
            </AuthorizeView>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private IReadOnlyList<LookupItem> _items = [];
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await Services.For<LookupService<TLookup>>().RunAsync(s => s.GetAllAsync(includeInactive: true));
        _items = result.IsSuccess ? result.Value : [];
        _loading = false;
    }

    private async Task EditAsync(LookupItem? item)
    {
        var parameters = new DialogParameters<LookupDialog<TLookup>> { { d => d.Item, item } };
        var title = item is null ? L["Catalog.AddItem"] : L["Catalog.EditItem"];
        var dialog = await DialogService.ShowAsync<LookupDialog<TLookup>>(title, parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(L["Common.Saved"], Severity.Success);
            await LoadAsync();
        }
    }
}
