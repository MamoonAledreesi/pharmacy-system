<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        @L["Nav.Dashboard"]
    </MudNavLink>

    <AuthorizeView Policy="@Permissions.CatalogView">
        <MudNavGroup Title="@L["Nav.Products"]" Icon="@Icons.Material.Filled.Medication" Expanded="true">
            <MudNavLink Href="catalog/products" Match="NavLinkMatch.Prefix">@L["Nav.ProductList"]</MudNavLink>
            <MudNavLink Href="catalog/lists">@L["Nav.CatalogLists"]</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.InventoryView">
        <MudNavLink Href="inventory" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inventory">@L["Nav.Inventory"]</MudNavLink>
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.CashView">
        <MudNavGroup Title="@L["Nav.Cash"]" Icon="@Icons.Material.Filled.AccountBalanceWallet">
            <MudNavLink Href="cash" Match="NavLinkMatch.All">@L["Nav.CashRegister"]</MudNavLink>
            <MudNavLink Href="cash/shifts" Match="NavLinkMatch.Prefix">@L["Nav.CashShifts"]</MudNavLink>
            <MudNavLink Href="cash/daily">@L["Nav.CashDaily"]</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Policy="@Permissions.SuppliersView">
        <MudNavGroup Title="@L["Nav.Purchases"]" Icon="@Icons.Material.Filled.LocalShipping">
            <MudNavLink Href="suppliers" Match="NavLinkMatch.Prefix">@L["Nav.Suppliers"]</MudNavLink>
            <AuthorizeView Policy="@Permissions.PurchasingView" Context="purchasing">
                <MudNavLink Href="purchases" Match="NavLinkMatch.Prefix">@L["Nav.PurchaseInvoices"]</MudNavLink>
            </AuthorizeView>
        </MudNavGroup>
    </AuthorizeView>

    @* Module entries are enabled as each module is delivered (see the roadmap). *@
    @foreach (var (key, icon) in _upcomingModules)
    {
        <MudNavLink Disabled="true" Icon="@icon" title="@L["Nav.ComingSoon"]">
            @L[key]
        </MudNavLink>
    }

    @* Administration entries are shown only to users who hold the permission. *@
    <AuthorizeView Policy="@Permissions.UsersManage">
        <MudNavLink Href="admin/users" Icon="@Icons.Material.Filled.ManageAccounts">@L["Nav.Users"]</MudNavLink>
        <MudNavLink Href="admin/roles" Icon="@Icons.Material.Filled.AdminPanelSettings">@L["Nav.Roles"]</MudNavLink>
    </AuthorizeView>
    <AuthorizeView Policy="@Permissions.AuditLogView">
        <MudNavLink Href="admin/audit" Icon="@Icons.Material.Filled.History">@L["Nav.AuditLog"]</MudNavLink>
    </AuthorizeView>
    <AuthorizeView Policy="@Permissions.SettingsManage">
        <MudNavLink Href="settings" Icon="@Icons.Material.Filled.Settings">@L["Nav.Settings"]</MudNavLink>
    </AuthorizeView>
</MudNavMenu>

@code {
    private static readonly (string Key, string Icon)[] _upcomingModules =
    [
        ("Nav.Sales", Icons.Material.Filled.PointOfSale),
        ("Nav.Customers", Icons.Material.Filled.People),
        ("Nav.Reports", Icons.Material.Filled.Assessment),
    ];
}
