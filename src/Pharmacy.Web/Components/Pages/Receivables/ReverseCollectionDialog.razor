@inject ServiceRunner Services

<MudDialog>
    <DialogContent>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
        }

        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
            @L["Receivables.ReverseWarning", MoneyFormat.Format(Amount)]
        </MudAlert>

        <MudTextField @bind-Value="_reason" Label="@L["Payables.ReverseReason"]" MaxLength="CustomerAccountEntry.NoteMaxLength" Lines="2" Required="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">@L["Common.Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(_saving || string.IsNullOrWhiteSpace(_reason))" OnClick="SaveAsync">
            @L["Receivables.Reverse"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public int CollectionId { get; set; }

    [Parameter, EditorRequired]
    public decimal Amount { get; set; }

    // One id per opened dialog: a double click or a retry is applied only once.
    private readonly Guid _operationId = Guid.NewGuid();
    private string? _reason;
    private string? _error;
    private bool _saving;

    private async Task SaveAsync()
    {
        _error = null;
        _saving = true;
        try
        {
            var request = new ReverseCollectionRequest(_operationId, CollectionId, _reason);
            var result = await Services.For<ReceivablesService>().RunAsync(s => s.ReverseCollectionAsync(request));

            if (result.IsFailure)
            {
                _error = L.Message(result.Error!);
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _saving = false;
        }
    }
}
