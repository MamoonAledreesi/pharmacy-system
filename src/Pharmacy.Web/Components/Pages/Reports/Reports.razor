@page "/reports"
@attribute [Authorize(Policy = Permissions.ReportsView)]
@inject IAuthorizationService AuthorizationService

<PageTitle>@L["Nav.Reports"] - @L["App.Name"]</PageTitle>

<div class="page-header">
    <MudText Typo="Typo.h4">@L["Nav.Reports"]</MudText>
    <MudSpacer />
    <MudTextField T="string" @bind-Value="_search" Immediate="true" Placeholder="@L["Reports.Search"]" Clearable="true" Variant="Variant.Outlined"
                  Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="reports-search" />
</div>

@foreach (var group in Visible)
{
    <section class="report-group @ReportStyle.ToneOf(group.Key)">
        <div class="report-group-title">
            <span class="report-icon"><MudIcon Icon="@ReportStyle.IconOf(group.Key)" /></span>
            <h2>@L[$"Reports.Group.{group.Key}"]</h2>
            <span class="report-group-count" dir="ltr">@group.Count()</span>
        </div>
        <div class="report-card-grid">
            @foreach (var report in group)
            {
                <a class="report-card" href="@($"reports/{report.Key}")" data-test="@($"report-{report.Key}")">
                    <span class="report-icon"><MudIcon Icon="@ReportStyle.IconOf(report.Key)" /></span>
                    <span class="report-card-body">
                        <span class="report-card-title">@L[$"Reports.Title.{report.Key}"]</span>
                        <span class="report-card-text">@L[$"Reports.Description.{report.Key}"]</span>
                    </span>
                    <MudIcon Icon="@(SupportedCultures.IsArabicUi ? Icons.Material.Filled.ChevronLeft : Icons.Material.Filled.ChevronRight)" Class="report-card-arrow" />
                </a>
            }
        </div>
    </section>
}

@if (!Visible.Any())
{
    <div class="empty-state">
        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" />
        <span>@L["Reports.NoData"]</span>
    </div>
}

@code {
    private IReadOnlyList<ReportDefinition> _available = [];
    private string? _search;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    // The reports this user may open, filtered by the search box (on the translated title and description).
    private IEnumerable<IGrouping<ReportGroup, ReportDefinition>> Visible =>
        _available
            .Where(d => string.IsNullOrWhiteSpace(_search)
                || L[$"Reports.Title.{d.Key}"].Value.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase)
                || L[$"Reports.Description.{d.Key}"].Value.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase))
            .GroupBy(d => d.Group);

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState).User;
        var canSeeCost = (await AuthorizationService.AuthorizeAsync(user, Permissions.ReportsViewCostAndProfit)).Succeeded;
        _available = [.. ReportDefinitions.All.Where(d => canSeeCost || !d.NeedsCostAndProfit)];
    }
}
